/* World surfaces and sprites, nearest texels (the software look). */
#include "r3d_common.cgh"

void main(float4 color : COLOR0, float2 tc0 : TEXCOORD0, float4 tc1 : TEXCOORD1,
          float4 params : TEXCOORD2, float4 texinfo : TEXCOORD3,
          float4 params2 : TEXCOORD4,
          uniform sampler2D tex : TEXUNIT0, uniform sampler2D lut : TEXUNIT1,
          out float4 oColor : COLOR)
{
    float4 s = tex2D(tex, Wrap(tc0, params));
    float4 c;

    if (s.a < 0.5)
        discard;

    c = Lut(lut, s.r, LightRow(tc1, params, params2, s.g));
    oColor = float4(c.rgb * color.rgb, color.a);
}
